# Build output
/bin/
/dist/
*.exe

# Generated protobuf code IS committed. It keeps builds hermetic (no network
# or buf toolchain needed to compile) and makes contract changes visible in
# review. Regenerate with `make proto`; CI fails if the output is stale.

# Local data and secrets
/.data/
/deploy/compose/.env
*.pem
*.key

# Go
vendor/
*.test
*.out
coverage.*

# Node / Next.js
node_modules/
.next/
out/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
